@{
    ViewData["Title"] = "My Cart";
    var cartDetails = ViewBag.CartDetails as List<object>;
    decimal total = ViewBag.Total ?? 0;
}

<h2 class="fw-bold mb-4"><i class="bi bi-cart-fill text-primary"></i> My Cart</h2>

@if (cartDetails == null || cartDetails.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-cart-x text-muted" style="font-size:4rem;"></i>
        <h4 class="mt-3 text-muted">Your cart is empty</h4>
        <a href="/Products" class="btn btn-primary mt-2 rounded-pill px-4">
            <i class="bi bi-grid"></i> Browse Products
        </a>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th class="text-center">Price</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (dynamic item in cartDetails)
                    {
                        <tr>
                            <td>
                                <i class="bi bi-box-seam text-primary me-2"></i>
                                <strong>@item.name</strong>
                            </td>
                            <td class="text-center text-muted">$@item.price</td>
                            <td class="text-center">
                                <span class="badge bg-primary rounded-pill px-3">
                                    @item.quantity
                                </span>
                            </td>
                            <td class="text-end fw-bold">$@item.subtotal</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light">
                        <td colspan="3" class="fw-bold text-end fs-5">Total:</td>
                        <td class="text-end fw-bold fs-5 text-primary">$@total</td>
                    </tr>
                </tfoot>
            </table>

            <div class="d-flex justify-content-between mt-3">
                <a href="/Products" class="btn btn-outline-primary rounded-pill px-4">
                    <i class="bi bi-arrow-left"></i> Continue Shopping
                </a>
                <div class="d-flex justify-content-between mt-3">
                    @* <a href="/Products" class="btn btn-outline-primary rounded-pill px-4">
                        <i class="bi bi-arrow-left"></i> Continue Shopping
                    </a> *@
                    <div class="d-flex gap-2">
                        <form method="post" action="/Cart/Clear">
                            <button type="submit" class="btn btn-outline-danger rounded-pill px-4"
                                    onclick="return confirm('Clear your cart?')">
                                <i class="bi bi-trash"></i> Clear Cart
                            </button>
                        </form>
                        <form method="post" action="/Cart/Purchase">
                            <button type="submit" class="btn btn-success rounded-pill px-4">
                                <i class="bi bi-bag-check"></i> Purchase Now
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}