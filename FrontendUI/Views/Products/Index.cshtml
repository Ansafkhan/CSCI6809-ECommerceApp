@using System.Text.Json
@model List<JsonElement>

@{
    ViewData["Title"] = "Products";
    var role = ViewBag.Role as string;

    var categoryColors = new Dictionary<string, string>
    {
        {"Electronics", "#667eea"},
        {"Fashion", "#e91e8c"},
        {"Home & Kitchen", "#ff6b35"},
        {"General", "#667eea"}
    };

    var categoryIcons = new Dictionary<string, string>
    {
        {"Electronics", "bi-cpu"},
        {"Fashion", "bi-bag"},
        {"Home & Kitchen", "bi-house"},
        {"General", "bi-grid"}
    };

    string GetProductImage(string name)
    {
        var n = name?.ToLower() ?? "";
        if (n.Contains("headphone") || n.Contains("wh-1000") || n.Contains("earphone"))
            return "/images/headphones.jpg";
        if (n.Contains("apple watch")) return "/images/applewatch.jpg";
        if (n.Contains("galaxy tab") || n.Contains("tab s") || n.Contains("ipad"))
            return "/images/tablet.jpg";
        if (n.Contains("iphone") || n.Contains("galaxy s") || n.Contains("phone"))
            return "/images/iphone.jpg";
        if (n.Contains("laptop") || n.Contains("dell") || n.Contains("xps") || n.Contains("macbook"))
            return "/images/laptop.jpg";
        if (n.Contains("analog") || n.Contains("wrist watch"))
            return "/images/analogwatch.jpg";
        if (n.Contains("watch")) return "/images/analogwatch.jpg";
        if (n.Contains("slim fit") || n.Contains("t-shirt") || n.Contains("tshirt"))
            return "/images/tshirt.jpg";
        if (n.Contains("jacket") || n.Contains("denim")) return "/images/jacket.jpg";
        if (n.Contains("sneaker") || n.Contains("running") || n.Contains("shoe"))
            return "/images/sneakers.jpg";
        if (n.Contains("wallet") || n.Contains("leather")) return "/images/wallet.jpg";
        if (n.Contains("air fryer") || n.Contains("fryer")) return "/images/airfryer.jpg";
        if (n.Contains("coffee")) return "/images/coffeemaker.jpg";
        if (n.Contains("vacuum")) return "/images/vacuum.jpg";
        if (n.Contains("blender")) return "/images/blender.jpg";
        if (n.Contains("microwave")) return "/images/microwave.jpg";
        // Try uploaded image using product name as filename
        return "/images/" + (name?.ToLower().Replace(" ", "") ?? "default") + ".jpg";
    }

    var categories = Model?
        .GroupBy(p => p.TryGetProperty("category", out var cat)
            ? cat.GetString() ?? "General" : "General")
        .ToDictionary(g => g.Key, g => g.ToList())
        ?? new();
}

<style>
    .product-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 18px !important;
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
    }

    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1) !important;
    }

    .product-img {
        transition: transform 0.3s ease;
        border-radius: 12px;
    }

    .product-card:hover .product-img {
        transform: scale(1.1) rotate(2deg);
    }

    .btn-cart {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 50px;
        color: white;
        transition: all 0.3s ease;
        font-size: 0.82rem;
    }

    .btn-cart:hover {
        transform: scale(1.03);
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.45);
        color: white;
    }

    .price-tag {
        font-size: 1.2rem;
        font-weight: 700;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .category-header {
        border-left: 4px solid;
        padding-left: 12px;
        margin: 28px 0 16px 0;
    }

    .cart-toast {
        position: fixed;
        top: 80px;
        right: 20px;
        z-index: 9999;
        display: none;
        min-width: 220px;
    }

    @@keyframes slideInRight {
        from {
            transform: translateX(60px);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes flyAway {
        0% {
            transform: scale(1) translate(0, 0);
            opacity: 1;
        }

        100% {
            transform: scale(0.2) translate(200px, -200px);
            opacity: 0;
        }
    }
</style>

<!-- Toast -->
<div class="cart-toast" id="cartToast">
    <div class="alert alert-success shadow rounded-4 d-flex align-items-center gap-3 py-3 mb-0">
        <i class="bi bi-cart-check-fill text-success fs-4"></i>
        <div>
            <div class="fw-bold">Added to cart!</div>
            <small class="text-muted">Item added successfully</small>
        </div>
    </div>
</div>

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0">🛍️ Shop</h2>
        <p class="text-muted small mb-0">@(Model?.Count ?? 0) products available</p>
    </div>
    @if (role == "Admin")
    {
        <a href="/Products/Create" class="btn btn-success rounded-pill px-4">
            <i class="bi bi-plus-circle me-1"></i>Add Product
        </a>
    }
</div>

<!-- Category Filter Pills -->
<div class="mb-4 d-flex gap-2 flex-wrap">
    <button class="btn btn-primary rounded-pill px-3 btn-sm filter-btn" onclick="filterCategory('all', this)">
        <i class="bi bi-grid me-1"></i>All
    </button>
    @foreach (var cat in categories.Keys)
    {
        var ic = categoryIcons.ContainsKey(cat) ? categoryIcons[cat] : "bi-grid";
        <button class="btn btn-outline-secondary rounded-pill px-3 btn-sm filter-btn"
                onclick="filterCategory('@cat', this)">
            <i class="bi @ic me-1"></i>@cat
        </button>
    }
</div>

@if (Model == null || Model.Count == 0)
{
    <div class="text-center py-5">
        <div style="font-size:4rem;">🛍️</div>
        <h4 class="mt-3 text-muted">No products yet</h4>
        @if (role == "Admin")
        {
            <a href="/Products/Create" class="btn btn-primary mt-2 rounded-pill">
                Add First Product
            </a>
        }
    </div>
}
else
{
    @foreach (var category in categories)
    {
        var catColor = categoryColors.ContainsKey(category.Key)
            ? categoryColors[category.Key] : "#667eea";
        var catIcon = categoryIcons.ContainsKey(category.Key)
            ? categoryIcons[category.Key] : "bi-grid";
        <div class="category-section" data-category="@category.Key">
            <div class="category-header" style="border-color:@catColor">
                <h5 class="fw-bold mb-0" style="color:@catColor">
                    <i class="bi @catIcon me-2"></i>@category.Key
                    <span class="badge rounded-pill ms-2 text-white" style="background:@catColor; font-size:0.65rem;">
                        @category.Value.Count items
                    </span>
                </h5>
            </div>
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3 mb-2">
                @foreach (var product in category.Value)
                {
                    var name = product.GetProperty("name").GetString() ?? "";
                    var imgSrc = GetProductImage(name);
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm product-card">
                            <div class="card-body p-3 text-center">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="badge rounded-pill text-bg-success" style="font-size:0.6rem;">In Stock</span>
                                    <span class="text-muted" style="font-size:0.7rem;">
                                        <i class="bi bi-box"></i>
                                        @product.GetProperty("stock").GetInt32()
                                    </span>
                                </div>
                                <a href="/Products/Details/@product.GetProperty("id").GetInt32()" class="text-decoration-none">
                                    <div class="mb-2 d-flex justify-content-center align-items-center" style="height:110px;">
                                        <img src="@imgSrc" alt="@name" class="product-img"
                                             style="width:100px; height:100px; object-fit:contain;"
                                             onerror="this.src='/images/tshirt.jpg'" />
                                    </div>
                                    <h6 class="fw-bold mb-1 text-dark" style="font-size:0.82rem; line-height:1.3;">
                                        @name
                                    </h6>
                                    <p class="text-muted mb-2" style="font-size:0.7rem; line-height:1.3;">
                                        @product.GetProperty("description").GetString()
                                    </p>
                                </a>
                                <div class="price-tag">
                                    $@product.GetProperty("price").GetDecimal()
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 p-3 pt-0">
                                @if (ViewBag.IsLoggedIn == true)
                                {
                                    <form onsubmit="addToCart(event, @product.GetProperty("id").GetInt32(), '@imgSrc')">
                                        <button type="submit" class="btn btn-cart w-100 py-2">
                                            <i class="bi bi-cart-plus me-1"></i>Add to Cart
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <a href="/Auth/Login" class="btn btn-cart w-100 py-2 text-white text-decoration-none">
                                        <i class="bi bi-cart-plus me-1"></i>Add to Cart
                                    </a>
                                }
                                @if (role == "Admin")
                                {
                                    <form method="post" action="/Products/Delete" class="mt-1">
                                        <input type="hidden" name="id" value="@product.GetProperty("id").GetInt32()" />
                                        <button type="submit" class="btn btn-outline-danger w-100 rounded-pill"
                                                style="font-size:0.72rem;" onclick="return confirm('Delete this product?')">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

<script>
    async function addToCart(event, productId, imgSrc) {
        event.preventDefault();
        const btn = event.submitter;
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Adding...';

        const rect = btn.getBoundingClientRect();
        const fly = document.createElement('img');
        fly.src = imgSrc;
        fly.style.cssText = `
        position:fixed; z-index:9999; pointer-events:none;
        left:${rect.left + rect.width / 2 - 30}px;
        top:${rect.top - 30}px;
        width:60px; height:60px;
        object-fit:contain; border-radius:12px;
        animation: flyAway 0.7s ease forwards;
    `;
        document.body.appendChild(fly);
        setTimeout(() => fly.remove(), 700);

        try {
            const formData = new FormData();
            formData.append('productId', productId);
            const response = await fetch('/Cart/AddItemAjax', {
                method: 'POST',
                body: formData
            });
            const result = await response.json();
            const toast = document.getElementById('cartToast');
            toast.style.display = 'block';
            toast.style.animation = 'slideInRight 0.3s ease';
            setTimeout(() => toast.style.display = 'none', 2000);
        } catch (e) {
            console.error(e);
        }

        setTimeout(() => {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-cart-plus me-1"></i>Add to Cart';
        }, 1000);
    }

    function filterCategory(cat, btn) {
        document.querySelectorAll('.filter-btn').forEach(b => {
            b.classList.remove('btn-primary');
            b.classList.add('btn-outline-secondary');
        });
        btn.classList.remove('btn-outline-secondary');
        btn.classList.add('btn-primary');
        document.querySelectorAll('.category-section').forEach(s => {
            s.style.display = (cat === 'all' || s.dataset.category === cat)
                ? 'block' : 'none';
        });
    }
</script>