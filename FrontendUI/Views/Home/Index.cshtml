            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card team-card shadow-sm p-4 text-center h-100" style="border-top: 4px solid #ff6b35;">
            <div class="team-avatar" style="background:linear-gradient(135deg,#ff6b35,#ffa726);">
                👨‍💻
            </div>
            <h5 class="fw-bold">Sizhan Xu</h5>
            <p class="text-muted small mb-2">Frontend Developer</p>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <span class="badge rounded-pill" style="background:#E3F2FD; color:#1976d2;">Products API</span>
                <span class="badge rounded-pill" style="background:#FCE4EC; color:#e91e8c;">Cart API</span>
