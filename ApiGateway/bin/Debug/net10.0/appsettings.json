{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "products-route": {
        "ClusterId": "products-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/products/{**catch-all}"
        }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/cart/{**catch-all}"
        }
      },
      "price-route": {
        "ClusterId": "price-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/price/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5155"
          }
        }
      },
      "products-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5048"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5106"
          }
        }
      },
      "price-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5097"
          }
        }
      }
    }
  }
}