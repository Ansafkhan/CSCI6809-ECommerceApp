{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "products-route": {
        "ClusterId": "products-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/products/{**catch-all}"
        }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/cart/{**catch-all}"
        }
      },
      "price-route": {
        "ClusterId": "price-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/price/{**catch-all}"
        }
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/inventory/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "HttpClient": {
          "VersionPolicy": "RequestVersionOrLower",
          "Version": "1.1"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://auth-api:80"
          }
        }
      },
      "products-cluster": {
        "HttpClient": {
          "VersionPolicy": "RequestVersionOrLower",
          "Version": "1.1"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://products-api:80"
          }
        }
      },
      "cart-cluster": {
        "HttpClient": {
          "VersionPolicy": "RequestVersionOrLower",
          "Version": "1.1"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://cart-api:80"
          }
        }
      },
      "price-cluster": {
        "HttpClient": {
          "VersionPolicy": "RequestVersionOrLower",
          "Version": "1.1"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://price-api:80"
          }
        }
      },
      "inventory-cluster": {
        "HttpClient": {
          "VersionPolicy": "RequestVersionOrLower",
          "Version": "1.1"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://inventory-api:80"
          }
        }
      }
    }
  }
}